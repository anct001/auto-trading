# .env.example — template ONLY. Copy to .env (git-ignored) and fill locally.
#
# §10 / Invariant 6/7: keys are trade-only, withdrawals DISABLED, IP-whitelisted, vaulted,
# never committed, never printed, never written to the event log. The Agent never handles the
# raw secret — the human enters these in the exchange's own UI and locally here.
#
# P0–P3 use testnet / dry-run ONLY. Real keys are added at P4 after the §14 go-live checklist.

# --- TRADING venue = bitbank (JFSA-registered, ADR 0002 + Findings, §10/§11) -----------------
# The ONLY venue that places real orders and supplies the OHLCV the bot backtests/signals on.
# Spot-only, withdrawals disabled, IP-whitelisted. P0-P3 use dry-run; real keys at P4.
# Chosen because ccxt has no Binance Japan entity; bitbank is the only ccxt JFSA venue with
# OHLCV support. Primary BTC quote is JPY (BTC/JPY). NOTE: bitbank has no public sandbox — keep
# SANDBOX handling as dry-run/paper (PaperBrokerExchange) until P4; never point real keys here pre-P4.
TRADING_EXCHANGE_ID=bitbank          # ccxt id (verified present in ccxt 4.5.60)
TRADING_EXCHANGE_SANDBOX=true        # no bitbank sandbox → paper/dry-run path until P4
TRADING_EXCHANGE_API_KEY=
TRADING_EXCHANGE_API_SECRET=

# --- VIEWING venue = Binance Global (ADR 0002) -----------------------------------------------
# READ-ONLY, operator-facing market data for the §12 research surfaces (watchlist/heatmap/
# screener/coin-detail). The bot NEVER makes a trade decision from this data and NEVER routes an
# order here. Public market data only — no key required, no order permission.
VIEW_EXCHANGE_ID=binance             # Binance Global public endpoint (market data only)
# (no API key here on purpose — viewing is public, read-only, non-trading)

# --- Local LLM slow loop (Ollama, off the trading path — §3) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
