# .env.example — template ONLY. Copy to .env (git-ignored) and fill locally.
#
# §10 / Invariant 6/7: keys are trade-only, withdrawals DISABLED, IP-whitelisted, vaulted,
# never committed, never printed, never written to the event log. The Agent never handles the
# raw secret — the human enters these in the exchange's own UI and locally here.
#
# P0–P3 use testnet / dry-run ONLY. Real keys are added at P4 after the §14 go-live checklist.

# --- Exchange (confirm entity at ORIENT: Binance Global vs Binance Japan — they differ, §10) ---
EXCHANGE_ID=binance
EXCHANGE_SANDBOX=true            # ccxt set_sandbox_mode(True) / Freqtrade dry_run until P4
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- Local LLM slow loop (Ollama, off the trading path — §3) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
